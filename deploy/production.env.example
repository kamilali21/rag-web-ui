# Copy to repo-root .env.production. Never commit real values.
# All CHANGE_ME values must be replaced; preflight deliberately rejects this file.
COMPOSE_PROJECT_NAME=researchiq
PUBLIC_DOMAIN=research.example.org
BACKEND_IMAGE=researchiq-backend:CHANGE_ME
FRONTEND_IMAGE=researchiq-frontend:CHANGE_ME
TLS_DIRECTORY=./deploy/tls
APP_SUBNET=172.30.240.0/24
PROXY_IP=172.30.240.10

# Choose prepared external volumes on the target host. Do not point an empty
# database at restored object/vector stores, or two app deployments at one DB.
MYSQL_VOLUME=researchiq_mysql_data
MINIO_VOLUME=researchiq_minio_data
CHROMA_VOLUME=researchiq_chroma_data
HF_CACHE_VOLUME=researchiq_huggingface_cache
UPLOADS_VOLUME=researchiq_uploads
MYSQL_DATABASE=ragwebui
MYSQL_USER=ragwebui
MYSQL_PASSWORD=CHANGE_ME_independent_random_secret
MYSQL_ROOT_PASSWORD=CHANGE_ME_different_random_secret
MINIO_ACCESS_KEY=CHANGE_ME_storage_user
MINIO_SECRET_KEY=CHANGE_ME_independent_random_secret
MINIO_BUCKET_NAME=documents
SECRET_KEY=CHANGE_ME_independent_random_secret
AUTH_OTP_SECRET=CHANGE_ME_independent_random_secret
EMAIL_OTP_ENABLED=true
AUTH_ORIGIN=https://research.example.org
AUTH_ALLOW_LOCAL_HTTP=false

SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=CHANGE_ME

# Route across compatible free OpenRouter chat models; keep the 384-dimension MiniLM index.
CHAT_PROVIDER=openai
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free
OPENAI_API_KEY=CHANGE_ME
EMBEDDINGS_PROVIDER=huggingface
HUGGINGFACE_EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_KEY=
VECTOR_STORE_TYPE=chroma
