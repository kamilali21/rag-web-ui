server_tokens off;
client_max_body_size 100M;

server {
    listen 80 default_server;
    server_name _;
    return 308 https://${PUBLIC_DOMAIN}$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name ${PUBLIC_DOMAIN};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($host != ${PUBLIC_DOMAIN}) { return 444; }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 180s;

    location /api { proxy_pass http://backend:8000; }
    location /openapi { proxy_pass http://backend:8000; }
    location /docs { proxy_pass http://backend:8000; }
    location /redoc { proxy_pass http://backend:8000; }
    location / { proxy_pass http://frontend:3000; }
}
